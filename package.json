{
  "name": "dynamic-card-saas",
  "version": "0.3.1",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node scripts/next-dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "test:e2e": "node scripts/e2e-check.mjs",
    "audit:mobile": "node scripts/mobile-audit.mjs",
    "verify": "npm run check && npm run test:unit && npm run audit:mobile && npm run test:e2e",
    "test:flows": "node scripts/flow-check.mjs",
    "create:user": "node scripts/create-user.mjs",
    "test:unit": "node --experimental-strip-types --no-warnings --import ./tests/alias-loader.mjs --test tests/*.test.mts",
    "db:check": "node scripts/db-setup.mjs check",
    "db:verify": "node scripts/db-setup.mjs verify",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:types": "node scripts/db-types.mjs",
    "supabase:auth": "node scripts/supabase-auth-config.mjs",
    "vercel:env": "node scripts/vercel-env.mjs",
    "test:rls": "node --experimental-strip-types --no-warnings --import ./tests/alias-loader.mjs --test tests/rls.test.mts",
    "db:bundle": "node scripts/bundle-migrations.mjs",
    "db:status": "node scripts/db-migrate.mjs --status",
    "email:check": "node scripts/email-check.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "nodemailer": "^10.0.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "postgres": "^3.4.9",
    "supabase": "^2.116.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
