{
  "name": "dynamic-card-saas",
  "version": "0.3.1",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node scripts/next-dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "test:e2e": "node scripts/e2e-check.mjs",
    "audit:mobile": "node scripts/mobile-audit.mjs",
    "verify": "npm run check && npm run test:unit && npm run audit:mobile && npm run test:e2e",
    "test:flows": "node scripts/flow-check.mjs",
    "create:user": "node scripts/create-user.mjs",
    "test:unit": "node --experimental-strip-types --no-warnings --test tests/*.test.mts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
