# כתובת האתר והמיתוג
# NEXT_PUBLIC_SITE_URL חייב להיות כתובת הפרודקשן המדויקת — ממנו נבנות כתובות
# החזרה של מיילי האימות וקישורי הכניסה, ולכן אסור להסתמך על כותרת Origin מהלקוח.
NEXT_PUBLIC_SITE_URL=https://naimly.co.il
NEXT_PUBLIC_BRAND_NAME=NAIMLY
NEXT_PUBLIC_BRAND_HEBREW_NAME=נעיםלי
NEXT_PUBLIC_BRAND_SHORT_NAME=N
NEXT_PUBLIC_SUPPORT_EMAIL=info.naimly@gmail.com
NEXT_PUBLIC_SUPPORT_WHATSAPP=972552951664

# דומיינים נוספים שמותר להם לשמש ככתובת חזרה (מופרדים בפסיק) — אופציונלי
ADDITIONAL_ALLOWED_ORIGINS=

# ── Supabase: Settings > API ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# מפתח שרת בלבד. אסור לחשוף אותו לדפדפן ואסור לתת לו קידומת NEXT_PUBLIC_.
# נדרש לאישור תשלומים, פתיחת חשבונות ושליחת פרטי כניסה.
SUPABASE_SERVICE_ROLE_KEY=

# ── תשלום בביט דרך וואטסאפ ─────────────────────────────────────────────────
# מספר הוואטסאפ שאליו נשלחות בקשות התשלום, בפורמט בינלאומי ללא סימנים.
# בלעדיו מסך התשלום חסום ומציג הודעה מתאימה.
NEXT_PUBLIC_BILLING_WHATSAPP=972552951664
# מספר הטלפון שאליו הלקוח מעביר בביט (מוצג בהוראות ובהודעה).
NEXT_PUBLIC_BIT_PHONE=055-295-1664
# השם שמופיע בביט, לאימות מול הלקוח.
NEXT_PUBLIC_BIT_NAME=NAIMLY

# ── מצב הדגמה ──────────────────────────────────────────────────────────────
# כשאין Supabase מוגדר, האתר מציג נתוני דוגמה ללא התחברות.
# בפרודקשן כבוי כברירת מחדל, כדי שפריסה עם משתנים חסרים לא תיפתח לציבור.
NEXT_PUBLIC_DEMO_MODE=false
# פותח את /admin גם בהדגמה. להשאיר כבוי בכל סביבה ציבורית.
DEMO_ADMIN=false

# ── שליחת מיילים ───────────────────────────────────────────────────────────
# מסלול א׳ (מומלץ): SMTP ישיר. עובד עם Gmail או כל ספק אחר.
# ל-Gmail נדרשת סיסמת אפליקציה בת 16 תווים — לא סיסמת החשבון הרגילה:
#   myaccount.google.com → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info.naimly@gmail.com
SMTP_PASSWORD=
SMTP_FROM=info.naimly@gmail.com

# כתובת לקבלת התראות מערכת (בקשות תשלום, פניות). ברירת מחדל: כתובת התמיכה.
ADMIN_NOTIFICATION_EMAIL=info.naimly@gmail.com

# מסלול ב׳ (חלופי): Adapter חיצוני — Make / Zapier / שרת תיווך.
EMAIL_API_URL=
EMAIL_API_SECRET=

# ── הפקת חשבוניות/קבלות דרך Adapter חיצוני — אופציונלי ─────────────────────
INVOICING_API_URL=
INVOICING_API_SECRET=

# מזהה סרטון YouTube להדגמה החיה בדף הבית — אופציונלי.
# בלעדיו מוצג מסך פתיחה שמוביל לכרטיס החי במקום נגן ריק.
NEXT_PUBLIC_DEMO_VIDEO_ID=

# ── הרצת מיגרציות (מקומי בלבד, ב-.env.local) ──────────────────────────────
# סיסמת מסד הנתונים: Supabase → Settings → Database → Database password
# נדרשת רק להרצת npm run db:migrate. לא נדרשת לאפליקציה עצמה.
SUPABASE_DB_PASSWORD=

# מחרוזת חיבור מלאה. נוצרת אוטומטית ע"י scripts/db-find-host.mjs,
# ומשמשת את db:migrate ואת בדיקת ה-RLS ב-db:verify.
SUPABASE_DB_URL=

# ── יצירת טיפוסים (npm run db:types, מקומי בלבד) ──────────────────────────
# Personal Access Token: https://supabase.com/dashboard/account/tokens
# מחליף את הצורך ב-`supabase login` ו-`supabase link`.
SUPABASE_ACCESS_TOKEN=
